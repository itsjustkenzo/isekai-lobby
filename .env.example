# Server only. Never prefix database credentials with VITE_.
MONGODB_URI=mongodb+srv://USERNAME:ENCODED_PASSWORD@cluster-1.flqbzk1.mongodb.net/
MONGODB_DATABASE=isekai-lobby
MONGODB_COLLECTION=game
PORT=3001

# Character sprite generation (server only)
OPENROUTER_API_KEY=
SPRITE_IMAGE_MODEL=openai/gpt-image-2.5-sunburst
SPRITE_IMAGE_QUALITY=high

# Layout analysis uses saved Assets Builder artwork; this model does not create images.
MAP_ANALYSIS_MODEL=google/gemini-2.5-flash
